# Gyman 환경변수 예시 — 실제 값은 .env 에 채우고 커밋하지 말 것(.gitignore).
# 이 파일(.env.example)만 커밋한다. 키 발급/배선 안내는 주석 참조.

# Supabase 프로젝트 설정 > API 에서 복사.
# anon 키는 클라 노출 전제(보안은 RLS). service_role 키는 절대 클라에 두지 말 것.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# 소셜 로그인·비밀번호 재설정 OAuth 콜백 딥링크 (선택 — 미설정 시 기본값 사용).
# Android intent-filter / iOS CFBundleURLTypes / Supabase 대시보드 Redirect URLs 와
# 정확히 같아야 한다. 상세: docs/social_login_plan.md §3.3.
OAUTH_REDIRECT_URL=io.supabase.gyman://login-callback
